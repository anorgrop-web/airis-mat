# Copy to .env.local and fill in the real values.
# Variable names are the SAME as the checkout (Checkout tapete pedra) and the advertorials.

# Meta Pixel ID (public). Fallback hardcoded in lib/fpixel.ts = Airis Mat pixel.
NEXT_PUBLIC_FB_PIXEL_ID=1264497399081223
# Meta Conversions API access token (SECRET — server only). Same dataset as the checkout.
FB_ACCESS_TOKEN=
# Optional: Events Manager test code to validate server events
FB_TEST_EVENT_CODE=

# GA4 measurement id (G-XXXXXXXXXX). Empty = GA disabled.
NEXT_PUBLIC_GA_ID=
# Google Ads tag id (AW-XXXXXXXXXX). Empty = Ads tag disabled.
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_PURCHASE_LABEL=

# Microsoft Clarity (project "Airis Mat"; fallback hardcoded in app/layout.tsx)
NEXT_PUBLIC_CLARITY_ID=ygctu8r7wc
