# Copy to .env.local and fill in the real values.

# Meta Pixel ID (public)
NEXT_PUBLIC_META_PIXEL_ID=

# Meta Conversions API access token (SECRET — server only)
META_CAPI_ACCESS_TOKEN=

# Optional: Events Manager test code to validate server events
# META_TEST_EVENT_CODE=

# Optional: Graph API version (default v23.0)
# META_API_VERSION=v23.0
